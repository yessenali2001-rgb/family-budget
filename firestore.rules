rules_version = '2';

// Доступ к бюджету есть только у общего аккаунта семьи (его пароль — PIN-код).
// Email должен совпадать с FAMILY_EMAIL в firebase-config.js.
// Вставьте эти правила в Firebase Console → Firestore Database → Rules и нажмите Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'family@family-budget.app';
    }
  }
}
